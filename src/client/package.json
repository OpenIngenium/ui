{
  "name": "ingenium-ui",
  "description": "Ingenium UI",
  "version": "1.0.0",
  "author": "JPL",
  "private": true,
  "scripts": {
    "dev": "../../gen_version.sh; cross-env NODE_ENV=development webpack --progress --watch",
    "build-single-node": "../../gen_version.sh; cross-env NODE_ENV=development webpack --progress --hide-modules && node timestamp ./dist/",
    "e2e": "../../gen_version.sh; protractor test/e2e/protractor.dev.conf.js",
    "webdriver-update": "webdriver-manager update",
    "e2e-ci": "../../gen_version.sh; protractor test/e2e/protractor.test.conf.js",
    "unit": "../../gen_version.sh; cross-env NODE_ENV=test NODE_OPTIONS=--max-old-space-size=4096 karma start test/unit/karma.dev.conf.js",
    "unit-ci": "../../gen_version.sh; cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 karma start test/unit/karma.test.conf.js --single-run",
    "build": "../../gen_version.sh; cross-env NODE_ENV=production webpack --progress --hide-modules && node timestamp ./dist/"
  },
  "dependencies": {
    "@casl/ability": "^3.2.0",
    "@casl/vue": "^0.5.1",
    "@fortawesome/fontawesome": "^1.1.6",
    "@fortawesome/fontawesome-free-brands": "^5.0.11",
    "@fortawesome/fontawesome-free-solid": "^5.0.11",
    "@fortawesome/vue-fontawesome": "0.0.22",
    "@handsontable/vue": "12.3.0",
    "@vue/composition-api": "^1.7.2",
    "axios": "^0.18.0",
    "bootstrap": "^4.4.1",
    "bootstrap-vue": "^2.13.0",
    "clipboard-polyfill": "^2.8.6",
    "core-js": "^3.45.1",
    "echarts": "^5.6.0",
    "exceljs": "^3.4.0",
    "fancy-grid-vue": "^1.0.5",
    "fancygrid": "^1.7.85",
    "froala-editor": "4.0.16",
    "handsontable": "12.3.0",
    "ing-vue-froalav3-wysiwyg": "4.0.16",
    "ing-vue-infinite-loading": "1.2.0",
    "jasmine-core": "^3.5.0",
    "jwt-decode": "^2.2.0",
    "karma-jasmine": "^2.0.1",
    "karma-jasmine-html-reporter": "^1.4.2",
    "lodash": "^4.17.10",
    "luxon": "^1.26.0",
    "moment-timezone": "^0.5.27",
    "simple-named-modules-plugin-webpack": "^1.0.0",
    "socket.io": "^2.2.0",
    "socket.io-client": "^2.2.0",
    "vue": "^2.5.17-beta.0",
    "vue-bootstrap-toggle": "^1.1.4",
    "vue-clipboard2": "^0.3.1",
    "vue-datetime": "^1.0.0-beta.14",
    "vue-echarts": "^6.5.5",
    "vue-multiselect": "^2.1.6",
    "vue-router": "^3.0.1",
    "vue-socket.io": "^3.0.7",
    "vue-text-highlight": "^2.0.10",
    "vue-toasted": "^1.1.28",
    "vue-typeahead-bootstrap": "^2.12.0",
    "vuex": "^3.0.1",
    "webpack-merge": "^4.1.2",
    "weekstart": "^1.1.0",
    "zinggrid": "^1.1.2"
  },
  "devDependencies": {
    "@babel/cli": "~7.0.0-beta.53",
    "@babel/core": "^7.28.3",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/runtime-corejs2": "^7.22.5",
    "@vue/test-utils": "~1.0.0-beta.14",
    "babel-loader": "^8.4.1",
    "babel-plugin-istanbul": "~4.1.6",
    "babel-plugin-lodash": "~3.3.4",
    "babel-preset-minify": "~0.3.0",
    "clean-webpack-plugin": "^0.1.19",
    "cross-env": "^5.1.1",
    "css-loader": "^0.28.7",
    "eslint": "^4.14.0",
    "eslint-loader": "^1.9.0",
    "eslint-plugin-vue": "^4.5.0",
    "extract-text-webpack-plugin": "^3.0.2",
    "faker": "^4.1.0",
    "file-loader": "^1.1.5",
    "jasmine-spec-reporter": "^4.2.1",
    "jquery": "^3.5.1",
    "jsdom": "^14.0.0",
    "jsonwebtoken": "^8.2.0",
    "karma": "^4.4.1",
    "karma-chrome-launcher": "^2.2.0",
    "karma-coverage": "^1.1.2",
    "karma-jsdom-launcher": "^7.1.0",
    "karma-junit-reporter": "^1.2.0",
    "karma-spec-reporter": "0.0.32",
    "karma-webpack": "^3.0.5",
    "mocha": "^5.1.0",
    "moment": "^2.22.0",
    "node-sass": "^4.11.0",
    "protractor": "^5.3.2",
    "sass-loader": "^6.0.7",
    "sinon": "^4.5.0",
    "style-loader": "^0.19.0",
    "url-loader": "^1.1.1",
    "vue-loader": "^14.2.1",
    "vue-template-compiler": "^2.5.17-beta.0",
    "webpack": "^3.8.1"
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "jasmine": true,
      "node": true,
      "es6": true,
      "protractor": true
    },
    "parserOptions": {
      "ecmaVersion": 2017,
      "sourceType": "module",
      "ecmaFeatures": {
        "modules": true
      }
    },
    "extends": [
      "eslint:recommended",
      "plugin:vue/essential"
    ],
    "rules": {
      "no-debugger": "warn",
      "no-console": "warn",
      "no-unused-vars": "warn",
      "no-var": "error",
      "semi": "error",
      "indent": "error",
      "space-before-function-paren": [
        "error",
        "never"
      ]
    },
    "overrides": [
      {
        "files": [
          "*.vue"
        ],
        "rules": {
          "indent": "off",
          "vue/script-indent": [
            "error",
            4,
            {
              "baseIndent": 1,
              "switchCase": 1
            }
          ],
          "vue/html-self-closing": [
            "error",
            {
              "html": {
                "component": "never",
                "normal": "any"
              }
            }
          ]
        }
      }
    ],
    "globals": {
      "process": true,
      "browser": true
    }
  },
  "engines": {
    "node": "8.10.0"
  }
}
