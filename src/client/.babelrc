{
  "presets": [
    ["@babel/preset-env", {
      "modules": false,
      "useBuiltIns": "usage",
      "corejs": 3,
      "targets": {
        "browsers": [
          "last 3 chrome versions",
          "last 2 edge versions",
          "last 2 firefox versions",
          "last 2 safari versions",
          ">0.5%",
          "not dead",
          "ie >= 11"
        ]
      }
    }]
  ],
  "plugins": [
    "babel-plugin-lodash",
    ["@babel/plugin-proposal-optional-chaining", { "loose": true }],
    ["@babel/plugin-proposal-nullish-coalescing-operator", { "loose": true }]
  ],
  "env": {
    "test": {
      "plugins": ["istanbul"]
    }
  }
}
