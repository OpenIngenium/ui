# Copy this file to `.env` in src/server/ and fill in real values for local development.
# `server.js` loads this automatically via `dotenv`. Never commit your actual `.env`.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Branding (shown in page titles / header) ---
APPLICATION_TITLE=Europa Clipper
APPLICATION_ACRONYM=Europa Clipper Ingenium
UI_CUSTOM_FOOTER=
# --- Froala editor license key (see https://froala.com) ---
FROALA_KEY=

# --- Command string format (CMD "Lookup" builder) ---
# Controls how STEM + ARGS are assembled into a command string. Rendered client-side by
# src/client/src/modules/elements/executable/cmd/cmd-string-format.js from
# window.cmdStringFormat (templateLocals.js -> head.ejs).
#
# Tokens: {{STEM}}, {{PRE_ARGS}}...{{/PRE_ARGS}}, {{POST_ARGS}}...{{/POST_ARGS}},
#         {{#ARGS}}...{{/ARGS}}, {{ARG_NAME}}, {{ARG_VALUE}}, {{SEP}}...{{/SEP}}
#         (PRE_ARGS/POST_ARGS render only when arguments exist; SEP joins BETWEEN arguments).
#
# Examples, for STEM=PWR_CTRL with args SUBSYSTEM=SSPA and STATE=ON:
#   {{STEM}}{{PRE_ARGS}},{{/PRE_ARGS}}{{#ARGS}}{{ARG_VALUE}}{{SEP}},{{/SEP}}{{/ARGS}}  (default)
#     -> PWR_CTRL,SSPA,ON      (no args: PWR_CTRL - the PRE_ARGS comma is skipped)
#   {{STEM}}{{#ARGS}} {{ARG_NAME}}={{ARG_VALUE}}{{/ARGS}}
#     -> PWR_CTRL SUBSYSTEM=SSPA STATE=ON
#
# Full token reference, more examples and the round-trip (re-parse) caveats:
# docs/Configuration.md#command-string-format. Keep the value quoted so '#' is not treated
# as a dotenv comment.
CMD_STRING_FORMAT="{{STEM}}{{PRE_ARGS}},{{/PRE_ARGS}}{{#ARGS}}{{ARG_VALUE}}{{SEP}},{{/SEP}}{{/ARGS}}"

# --- Security ---
# Used to sign CSRF tokens. Set a long random value in production.
# Falls back to a dev-only default if unset - MUST be overridden in production.
CSRF_SECRET=

# Set to "true" to verify TLS certs when this server calls backend microservices.
VERIFY_REQUESTS_SSL=false
# Set to "true" to log upstream request/response status lines (never logs headers/bodies/secrets).
UI_ENABLE_DEBUG_INFORMATION=false

# --- Backend microservice base URLs (ONE var per service - used both server-side by this
# Node process AND as the reverse-proxy target for the client's direct /core_server,
# /auth_server, /dict_server, /report_server, /search_server, /execution_monitor calls -
# see routes/clientProxy.js, which extracts the origin (protocol+host) from each URL below).
# These defaults assume a local `docker-compose` stack exposing each backend service on
# 127.0.0.1:<port>. Adjust to match your own environment.
# Core API (executions, procedures, venues, comments)
CORE_API_URL=http://127.0.0.1:8002/api/v5/
# Auth API (login, JWT refresh, roles, LDAP lookup)
AUTH_API_URL=http://127.0.0.1:8007/api/v2/
# Dictionary service (cmd/evr/eha lookups, dictionary CRUD)
DICT_API_URL=http://127.0.0.1:8003/api/v4/
# Archive API (health check only, currently)
ARCHIVE_API_URL=http://127.0.0.1:8010/api/v5/
# Execution server (health check only, currently)
EXECUTION_SERVER_URL=http://127.0.0.1:9999/api/v4/
# Report service
REPORT_API_URL=http://127.0.0.1:3003
# Search service
SEARCH_API_URL=http://127.0.0.1:3025
# Live execution status updates (socket.io/WebSocket)
EXECUTION_MONITOR_URL=http://127.0.0.1:3000

# --- Auth / JWT ---
# "password" or "rsa" - controls the X-AUTH-METHOD header sent to AUTH_API_URL and the
# label shown on the login form (JPL Password vs RSA PIN+TOKENCODE).
AUTH_METHOD=password
# RSA public key (PEM) used to verify JWTs issued by the auth service. Required for login,
# session-expiration checks, and token renewal to work. Multi-line - either escape newlines
# as \n or use a secrets manager / mounted file and read it at startup.
PUBLIC_PEM=

# --- JS bundle filenames ---
# Defaults already match the plain filenames emitted by `npm run build:single-node` in
# src/client/dist (e.g. dashboard-bundle.js). Only override if your build produces
# hashed/timestamped filenames (see js_filename_to_env.sh at the repo root) or you're using
# build:single-node vs build (prod) with different output names.
# AUTHORING_JS_BUNDLE=authoring-bundle.js
# DASHBOARD_JS_BUNDLE=dashboard-bundle.js
# EXECUTE_AS_RUN_JS_BUNDLE=execute-as-run-bundle.js
# EXECUTION_JS_BUNDLE=execution-bundle.js
# EXECUTIONS_JS_BUNDLE=executions-bundle.js
# PROJECT_CONFIG_JS_BUNDLE=project-config-bundle.js
# VENUE_DETAIL_JS_BUNDLE=venue-detail-bundle.js
# REPORTING_JS_BUNDLE=reporting-bundle.js
# HEADER_JS_BUNDLE=header-bundle.js
# ADMIN_JS_BUNDLE=admin-bundle.js
# SEARCH_JS_BUNDLE=search-bundle.js
